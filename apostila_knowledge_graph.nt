class_SupplyChainAgent:
____"""Especialista_em_supply_chain"""
____
____def___init__(self,_llm,_retriever):
________self.llm_=_llm
________self.retriever_=_retriever
________self.logger_=_logging.getLogger(__name__)
____
____def_process(self,_state:_QueryState)_->_QueryState:
________"""Processar_query_de_supply_chain"""
________
________#_Recuperar_documentos_relevantes
________docs_=_self.retriever.query(state["query"],_k=5)
________context_=_"\n".join([d["text"]_for_d_in_docs])
________
________#_Gerar_resposta
________prompt_=_f"""Você_é_especialista_em_supply_chain.

CONTEXTO:
{context}

PERGUNTA:
{state['query']}

RESPONDA:_Baseado_no_contexto,_qual_é_a_resposta?"""
________
________response_=_self.llm.complete(prompt)
________
________self.logger.info("✅_Supply_Chain_Agent_processou_query")
________
________return_{
